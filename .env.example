# Copy to .env (never commit .env). Both services read this file from the repo root.
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-6-luna
OPENAI_MODEL_SMART=gpt-6.1-sol

# 1 = run with fixture data and no network calls (default for demos)
MOCK=1

# universal-memory: skip its npx skills installer
UMEM_OFFLINE=1

# Machine 3 only: Google Cloud OAuth "Desktop app" client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:7702/auth/callback

# Machine 3: let create_event proposals skip approval
AUTO_APPROVE_CALENDAR=0
